#!/usr/bin/make -f

%:
	dh $@ --builddir build/

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=release

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp
	# clean redundant license files
	rm -rf debian/tmp/usr/share/vpl-tools/licensing

override_dh_clean:
	rm -rf _build
	dh_clean
